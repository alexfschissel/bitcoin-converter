{
  "version": 2,
  "builds": [
    {"src": "api/**/*.js", "use": "@vercel/node"},
    {"src": "*.html", "use": "@vercel/static"},
    {"src": "sw.js", "use": "@vercel/static"},
    {"src": "robots.txt", "use": "@vercel/static"},
    {"src": "sitemap.xml", "use": "@vercel/static"},
    {"src": "ads.txt", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/$1"},
    {"src": "/sw.js", "dest": "/sw.js"},
    {"src": "/robots.txt", "dest": "/robots.txt"},
    {"src": "/sitemap.xml", "dest": "/sitemap.xml"},
    {"src": "/ads.txt", "dest": "/ads.txt"},
    {"src": "/converter-bitcoin-real", "dest": "/converter-bitcoin-real.html"},
    {"src": "/converter-bitcoin-dolar", "dest": "/converter-bitcoin-dolar.html"},
    {"src": "/quanto-vale-1-bitcoin", "dest": "/quanto-vale-1-bitcoin.html"},
    {"src": "/contato", "dest": "/contato.html"},
    {"src": "/sobre", "dest": "/sobre.html"},
    {"src": "/inovacao", "dest": "/inovacao.html"},
    {"src": "/", "dest": "/index.html"}
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {"key": "Service-Worker-Allowed", "value": "/"},
        {"key": "Content-Type", "value": "application/javascript"}
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {"key": "Content-Type", "value": "application/xml; charset=utf-8"},
        {"key": "Cache-Control", "value": "public, max-age=3600"}
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {"key": "Content-Type", "value": "text/plain; charset=utf-8"}
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {"key": "Content-Type", "value": "text/plain; charset=utf-8"},
        {"key": "Cache-Control", "value": "public, max-age=86400"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    }
  ]
}
